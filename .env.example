# ---------------------------------------------------------------------------
# Copie para `.env` (ja ignorado pelo git) e preencha os dois primeiros valores.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# OBRIGATORIO -- Personal Access Token do Databricks.
# Onde pegar: canto superior direito > Settings > Developer > Access tokens
#             > Generate new token. Precisa de CAN QUERY no serving endpoint
#             e CAN USE no SQL Warehouse.
DATABRICKS_TOKEN=dapi000000000000000000000000000000

# OBRIGATORIO -- caminho HTTP do SQL Warehouse (para ler a ABT da camada Gold).
# Onde pegar: SQL > SQL Warehouses > (seu warehouse) > Connection details
#             > campo "HTTP path".
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000

# ---------------------------------------------------------------------------
# OPCIONAIS -- ja tem default no codigo, so preencha se mudar de workspace,
# endpoint ou nome de tabela.
# ---------------------------------------------------------------------------

# SERVING_ENDPOINT_URL=https://dbc-eb5c1364-5cd5.cloud.databricks.com/serving-endpoints/f1-champions/invocations
# DATABRICKS_HOST=dbc-eb5c1364-5cd5.cloud.databricks.com
# ABT_TABLE=lakehouse.gold.abt_f1_drivers_champion
# RESULTS_TABLE=lakehouse.bronze.f1_results

# ---------------------------------------------------------------------------
# Etapa de coleta local (main.py / sender.py) -- nao usado pelo app Streamlit.
# ---------------------------------------------------------------------------
# AWS_KEY=
# AWS_SECRET_KEY=
# BUCKET_NAME=
